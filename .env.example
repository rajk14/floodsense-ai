# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENWEATHER_API_KEY: Optional - for better weather data.
OPENWEATHER_API_KEY="MY_OPENWEATHER_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional - for Google Maps integration.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# TWILIO_ACCOUNT_SID: Optional - for real SMS broadcasts.
TWILIO_ACCOUNT_SID="MY_TWILIO_SID"
TWILIO_AUTH_TOKEN="MY_TWILIO_TOKEN"
TWILIO_PHONE_NUMBER="MY_TWILIO_PHONE"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
